# ==============================================================================
# MARKETIVITY SMART INVOICE & PAYMENT MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# Database Configuration (PostgreSQL / Neon)
# REQUIRED FOR DURABLE PRODUCTION STORAGE
# Example: postgresql://postgres:password@ep-cold-smoke-123456.us-east-2.aws.neon.tech/marketivity?sslmode=require
DATABASE_URL=your_postgresql_connection_string_here

# Local Persistent PGlite Storage Directory (Used as local dev fallback if DATABASE_URL is unset)
# Defaults to .data/pglite
PGLITE_DATA_DIR=.data/pglite

# Authentication Configuration (Better Auth)
# Set to 'true' for production authentication.
VITE_AUTH_ENABLED=true

# Better Auth Application URL (e.g. http://localhost:8080 in dev, https://billing.marketivity.com in prod)
BETTER_AUTH_URL=http://localhost:8080

# Production secret key for signing Better Auth sessions (generate via `openssl rand -hex 32`)
BETTER_AUTH_SECRET=
